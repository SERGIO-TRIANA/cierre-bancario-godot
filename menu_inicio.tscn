theme_override_font_sizes/normal_font_size = 18
text = "CONTROLES: Muévete con Flechas o WASD.
OBJETIVO: Completa las 8 tareas del cierre bancario antes de que el reloj llegue a 00:00. Sigue el marcador verde (!) que aparece en la sala indicada arriba.

CUIDADO EN LAS SALAS:
- Clientes (Salas 7, 8 y 9): Evita su cono rojo.
- Asesores (Sala 5): Si les sale \"?\", te harán trivia.
- Cajeros (Sala 6): Te perseguirán si tienen una duda.
- Aseadora (Sala 2): Evita su círculo rojo en la cafetería."
autowrap_mode = 2
horizontal_alignment = 1

